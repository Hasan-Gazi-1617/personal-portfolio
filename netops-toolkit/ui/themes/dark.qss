QWidget{background:#0e1726;color:#e8eef7;font-family:'Segoe UI',sans-serif;font-size:13px}QMainWindow{background:#0e1726}QFrame#sidebar{background:#0a1220;border-right:1px solid #26364b}QLabel#brand{color:#5eead4;font-size:20px;font-weight:700}QLabel#title{font-size:25px;font-weight:700;color:#f8fafc}QLabel#muted{color:#9aabc0}QFrame#panel{background:#162337;border:1px solid #2a3d56;border-radius:12px}QPushButton{background:#1b2d45;color:#edf4fc;border:1px solid #344b68;border-radius:8px;padding:9px 12px}QPushButton:hover,QPushButton:checked{background:#155b58;border-color:#5eead4}QLineEdit,QSpinBox,QTextEdit{background:#0b1422;color:#f1f5f9;border:1px solid #344b68;border-radius:7px;padding:9px}
